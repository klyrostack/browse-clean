{
  "manifest_version": 3,
  "name": "BrowseClean — Universal Web Declutterer",
  "short_name": "BrowseClean",
  "description": "Production-grade declutter engine that eliminates cookie consent walls, newsletter popups, live chat widgets, and scroll-locks.",
  "version": "1.1.0",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BrowseClean"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["cleaner.css"],
      "js": ["engine.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-zapper": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Activate Element Zapper"
    }
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
